# Copy this file to ".env" and edit the values:   cp .env.example .env   (Windows: copy .env.example .env)

# --- Security -------------------------------------------------------------
# Long random string (32+ chars). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If left as "change-me..." a temporary key is used and logins reset on every restart.
SECRET_KEY=change-me-generate-a-long-random-string
TOKEN_EXPIRE_MINUTES=60
LOGIN_MAX_ATTEMPTS=10

# --- Database -------------------------------------------------------------
# SQLite file is created automatically. Any SQLAlchemy URL also works (e.g. PostgreSQL).
DATABASE_URL=sqlite:///./data/selfcorrect.db

# --- AI provider ----------------------------------------------------------
# mock       = offline rule-based demo engine, no API key needed (default)
# anthropic  = Claude via the Anthropic API (needs LLM_API_KEY)
# openai     = any OpenAI-compatible API (OpenAI, Groq, Ollama, ...)
LLM_PROVIDER=mock
LLM_API_KEY=
# Leave empty for the provider default (anthropic: claude-sonnet-5-5, openai: gpt-4o-mini)
LLM_MODEL=
# Leave empty for the provider default. For local Ollama: http://localhost:11434/v1
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=60

# --- Pipeline -------------------------------------------------------------
# Maximum Critic review rounds per task (1-5 can also be set per request)
MAX_ITERATIONS=3

# --- Server ---------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
# Comma-separated list of allowed browser origins, or * for all
CORS_ORIGINS=*
